ARG GO_BUILDER_IMAGE=golang:1.25-alpine
ARG ALPINE_IMAGE=alpine:3.22

FROM --platform=$BUILDPLATFORM ${GO_BUILDER_IMAGE} AS builder

ARG TARGETOS
ARG TARGETARCH
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=$GOPROXY

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/blackbox_exporter .

FROM ${ALPINE_IMAGE}

ARG ALPINE_REPOSITORY_MIRROR
RUN if [ -n "$ALPINE_REPOSITORY_MIRROR" ]; then \
      sed -i "s#https://dl-cdn.alpinelinux.org/alpine#$ALPINE_REPOSITORY_MIRROR#g" /etc/apk/repositories; \
    fi \
    && apk add --no-cache libcap \
    && addgroup -S ping \
    && adduser -S -G ping ping
COPY --from=builder /out/blackbox_exporter /bin/blackbox_exporter
COPY blackbox.yml /etc/blackbox_exporter/config.yml
RUN setcap cap_net_raw+ep /bin/blackbox_exporter

USER ping
EXPOSE 9115
ENTRYPOINT ["/bin/blackbox_exporter"]
CMD ["--config.file=/etc/blackbox_exporter/config.yml"]
